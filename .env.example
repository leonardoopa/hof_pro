# Único arquivo de configuração do projeto. Copie para .env nesta pasta (raiz):
#   cp .env.example .env
# O docker compose lê este .env, e o backend também o lê quando roda fora do Docker.
# Os valores abaixo são de desenvolvimento: troque senha e chave fora do seu computador.

DJANGO_SECRET_KEY=dev-insecure-key-change-me-0123456789abcdef
DJANGO_DEBUG=1
JWT_LIFETIME_HOURS=12
CORS_ORIGINS=http://localhost:5173

# Banco: mssql (padrão) ou sqlite (fora do Docker, sem driver ODBC).
# No Docker o compose fixa DB_ENGINE=mssql, DB_HOST=sqlserver e DB_USER=sa; o resto vem daqui.
DB_ENGINE=mssql
DB_NAME=hofpro
DB_USER=sa
# Senha do SQL Server: 8+ caracteres com maiúscula, minúscula, número e símbolo.
# Ela fica gravada no volume na primeira subida; para trocar depois: docker compose down -v
DB_PASSWORD=HofPro!Dev2026
DB_HOST=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 18 for SQL Server
